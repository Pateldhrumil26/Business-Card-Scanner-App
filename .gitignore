# ==========================================
# Root .gitignore for Business Card Scanner App
# ==========================================

# Environment variables & secrets (CRITICAL)
**/.env
**/.env.*
!**/.env.example

# Node.js / Backend
**/node_modules/
**/dist/
**/uploads/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter / Dart / Frontend
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
.widget_preview/

# Android Studio / Xcode build artifacts
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/.gradle/
**/ios/Flutter/.last_build_id
**/ios/Pods/

# Operating System & IDE Files
.DS_Store
Thumbs.db
Desktop.ini
*.class
*.pyc
*.swp
*.swo
.idea/
.vscode/
*.iml
*.ipr
*.iws
