{
  "name": "business-card-scanner-backend",
  "version": "1.0.0",
  "description": "Production-ready TypeScript backend API for Business Card Scanner with AWS S3 storage",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test:parser": "ts-node tests/parser.test.ts",
    "test:api": "ts-node tests/api.test.ts",
    "test": "ts-node tests/parser.test.ts"
  },
  "keywords": [
    "business-card-scanner",
    "ocr",
    "express",
    "typescript",
    "mongodb",
    "aws-s3"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.712.0",
    "@aws-sdk/s3-request-presigner": "^3.712.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
